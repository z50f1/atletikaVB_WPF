<Window x:Class="atletikaVB_WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Atlétika VB 2017" Height="600" Width="1000">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="tabla"
              Grid.Row="0"
              AutoGenerateColumns="True"
              IsReadOnly="True"
              SelectionMode="Single"
              Margin="0,0,0,10"/>

        <Grid Grid.Row="1"
          Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="3">
                <Label Content="Verseny"/>
                <TextBox x:Name="txtVerseny"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="3">
                <Label Content="Nem"/>
                <TextBox x:Name="txtNem"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="3">
                <Label Content="Ország"/>
                <TextBox x:Name="txtOrszag"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="3">
                <Label Content="Név"/>
                <TextBox x:Name="txtNev"/>
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="3">
                <Label Content="Eredmény"/>
                <TextBox x:Name="txtEredmeny"/>
            </StackPanel>
            <StackPanel Grid.Column="5" Margin="3">
                <Label Content="Rekord"/>
                <TextBox x:Name="txtRekord"/>
            </StackPanel>
            <StackPanel Grid.Column="6" Margin="3">
                <Label Content="Helyezés"/>
                <TextBox x:Name="txtHelyezes"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Beolvasas" Content="Beolvasás" Width="110" Height="35" Margin="5" Click="Beolvasas_Click"/>
            <Button x:Name="Hozzaadas" Content="Hozzáadás" Width="110" Height="35" Margin="5" Click="Hozzaadas_Click"/>
            <Button x:Name="Modositas" Content="Módosítás" Width="110" Height="35" Margin="5" Click="Modositas_Click"/>
            <Button x:Name="Torles" Content="Törlés" Width="110" Height="35" Margin="5" Click="Torles_Click"/>
            <Button x:Name="Mentes" Content="Mentés" Width="110" Height="35" Margin="5" Click="Mentes_Click"/>
        </StackPanel>

    </Grid>

</Window>